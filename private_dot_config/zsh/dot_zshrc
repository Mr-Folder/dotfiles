# Path to your oh-my-zsh installation.
export ZSH="$XDG_CONFIG_HOME/zsh/.oh-my-zsh"
export ZSH_CUSTOM=$HOME/.config/zsh_custom/
export HISTFILE="$XDG_CONFIG_HOME/zsh/.zsh_history"
export ZSH_COMPDUMP=$ZSH/cache/.zcompdump-$HOST
plugins=(copybuffer copyfile dirhistory git jsontools sudo web-search zsh-autosuggestions)

source $ZSH/oh-my-zsh.sh

#######################################################
#################### HISTORY ##########################
#######################################################
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS

#######################################################
###################### PATH ###########################
#######################################################
export PATH="$PATH:/opt/nvim-linux64/bin"
export PATH="$PATH:$HOME/.local/bin:/usr/local/go/bin"
export PATH="$PATH:/opt/nvim/"
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
export PATH="$PATH:/usr/sbin"
export PATH="$PATH:$HOME/go/bin"

#######################################################
##################### ENV #############################
#######################################################
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#4e4e4e,bold"
export WORDLIST="/usr/share/wordlist/"
export ZLE_RPROMPT_INDENT=6
export KUBE_EDITOR="vim"
export JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
export MANPAGER='nvim --appimage-extract-and-run +Man!'
export EDITOR='nvim'
export KUBE_EDITOR='nvim'

# nvm: lazy-loaded (sourcing nvm.sh is the slowest part of shell startup).
# Put the newest installed node on PATH directly so node/npm/npx work
# without loading nvm; the nvm function loads it on first use.
export NVM_DIR="$HOME/.config/nvm"
if [ -d "$NVM_DIR/versions/node" ]; then
  export PATH="$NVM_DIR/versions/node/$(ls -v "$NVM_DIR/versions/node" | tail -1)/bin:$PATH"
fi
nvm() {
  unfunction nvm
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
  nvm "$@"
}

#######################################################
##################### ALIAS ###########################
#######################################################
alias updt="sudo apt-get update && sudo apt-get upgrade"
alias dirbuster="java -jar /opt/dirbuster/DirBuster-1.0-RC1.jar"
alias dls="docker image ls"
alias k="kubectl"
alias dl='cd $HOME/Downloads/'
alias sds='cd $HOME/Workspace/sds/'
alias workspace='cd $HOME/Workspace/'
alias sb='cd $HOME/Workspace/Brain/'
alias lt="eza -la --icons --git --group-directories-first"
alias dmux="tmuxinator"
alias lab="cd $HOME/Workspace/homelab/"

#######################################################
################### FUNCTIONS #########################
#######################################################
nettool() {
  if ! kubectl get pod nettool-debug &>/dev/null; then
    kubectl run nettool-debug --image=nicolaka/netshoot --restart=Always -- sleep infinity
    kubectl wait --for=condition=ready pod/nettool-debug --timeout=30s
  fi
  kubectl exec -it nettool-debug -- /bin/bash
}

# Various sources
if [ -d "/home/linuxbrew" ];then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

eval "$(starship init zsh)"

if [ -f $HOME/.cargo/env ]; then
  . "$HOME/.cargo/env"
fi

# Set up fzf key bindings and fuzzy completion
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
